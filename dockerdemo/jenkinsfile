
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'devops-dockerdemo'
        IMAGE_TAG = "${BUILD_NUMBER}"
        CONTAINER_NAME = 'jenkins-dockerdemo'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-credentials',
                    url: 'https://github.com/its-sourabh-01/DevOps.git'
            }
        }

        stage('Check Workspace') {
            steps {
                sh '''
                    pwd
                    ls -la
                    find . -name Dockerfile
                '''
            }
        }

        stage('Docker build') {
            steps {
                dir('dockerdemo') {
                    sh '''
                        docker build -t "${IMAGE_NAME}:${IMAGE_TAG}" .
                    '''
                }
            }
        }

        stage('Docker container') {
            steps {
                sh '''
                    docker rm -f "${CONTAINER_NAME}" || true

                    docker run -d \
                        --name "${CONTAINER_NAME}" \
                        -p 9000:8080 \
                        "${IMAGE_NAME}:${IMAGE_TAG}"

                    docker ps
                '''
            }
        }
    }

    post {
        success {
            echo 'Docker image built and container started successfully!'
        }
        failure {
            echo 'Docker image build or container startup failed!'
        }
        always {
            echo 'Docker pipeline completed'
        }
    }
}
